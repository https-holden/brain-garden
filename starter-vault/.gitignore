# Obsidian state that changes constantly and is per device
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace/
.obsidian/cache/
.trash/
.DS_Store

# Claude Code local permissions
.claude/settings.local.json

# Script logs and local secrets never land in git
bin/*.log
bin/.env
__pycache__/

# The find log (every lookup) stays on this machine; the index beside it is committed
.paths/find.log

# Words bin/beds.py never lets leave for a bed: the list itself never leaves either
bin/never-share.txt
